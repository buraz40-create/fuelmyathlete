# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Capacitor / Android
# The android/ directory is committed: it holds the manifest, the Gradle config and the icons,
# all of which are edited by hand and are part of the app. Only the build output and the machine
# specific bits are ignored.
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
# The Firebase config carries project identifiers. It is not a secret in the password sense, but
# it belongs to whoever owns the Firebase project rather than to the repository.
android/app/google-services.json

# Play signing key and its passwords. Never commit.
android/keystore.properties
*.jks
*.keystore
