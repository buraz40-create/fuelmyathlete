<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      enableOnBackInvokedCallback is forced back to false, and tools:replace is what makes that
      stick: Capacitor's own library manifest sets it to true, and the merged manifest wins
      unless we say otherwise.

      With it true and targetSdk 36 on Android 13 or later, the system routes back through the
      predictive back callback and never calls the legacy onBackPressed that Capacitor's
      backButton listener is built on. The effect is that pressing back leaves the app from any
      screen and no JavaScript listener can prevent it. Found on an emulator: back from the
      recipe list dropped straight to the launcher, and it kept happening after I had added a
      listener by hand, which is what ruled out our own code.

      Turning it off restores the legacy path, which is what the plugin expects. The cost is the
      Android 14 predictive back animation, which this app does not use.
    -->
    <application
        android:enableOnBackInvokedCallback="false"
        tools:replace="android:enableOnBackInvokedCallback"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Camera, for importing a recipe by photographing a cookbook page or a screenshot.

      The Capacitor camera plugin brings its own code but declares nothing, so without these
      three a capture fails at runtime with a permission error rather than at build time. That
      is the sort of thing that is only discovered on a real phone, so it is declared here now.

      READ_MEDIA_IMAGES is the Android 13 and later way to reach the gallery.
      READ_EXTERNAL_STORAGE is kept for older devices and capped at 32, because from 33 it is
      ignored and leaving it uncapped makes the Play Console ask why an app that only needs one
      photo wants the whole filesystem.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      A phone with no camera should still be able to install this. The camera is one optional
      route into the import screen, not the reason the app exists.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
