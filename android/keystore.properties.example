# Copy to android/keystore.properties and fill in. That file is gitignored and must stay that
# way: it holds the passwords to the key that identifies this app on Google Play for its whole
# life. Back up both this file and the .jks itself somewhere that is not only this laptop.
#
# Create the key first (once, ever):
#
#   keytool -genkeypair -v -keystore fuelmyathlete-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias fuelmyathlete
#
# storeFile is relative to the android/ directory, or an absolute path.
storeFile=../fuelmyathlete-release.jks
storePassword=
keyAlias=fuelmyathlete
keyPassword=
